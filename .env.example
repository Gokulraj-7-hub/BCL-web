# ----------------------------------------------------------------------------
# BugCap Labs Pvt. Ltd. — environment variables
# Copy to `.env.local` for development and set the same keys in the Vercel
# dashboard for production. Never commit real credentials.
# ----------------------------------------------------------------------------

# Canonical public site URL (no trailing slash). Used for SEO metadata,
# sitemap.xml, robots.txt, canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://bugcaplabs.com

# --- Contact form delivery (SMTP via Nodemailer, server-side only) ----------
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bugcaplabinfo@gmail.com
SMTP_PASSWORD=your-app-password-here

# Mailbox that receives contact-form submissions.
CONTACT_TO_EMAIL=bugcaplabinfo@gmail.com
# "From" address used by the transport (must be allowed by your SMTP provider).
CONTACT_FROM_EMAIL=bugcaplabinfo@gmail.com

# --- Analytics (optional) ---------------------------------------------------
# Leave empty to disable Google Analytics entirely.
NEXT_PUBLIC_GA_ID=

# --- Search Console (optional) ---------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
